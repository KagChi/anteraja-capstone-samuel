{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "automation:basics": "node tests/automation/session-1-fundamentals.mjs",
    "automation:e2e": "node tests/automation/session-2-shipment-e2e.mjs",
    "automation:regression": "node tests/automation/session-3-regression.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@inertiajs/react": "^2.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0.0",
    "puppeteer": "^25.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.7",
    "vitest": "^5.0.2"
  }
}
