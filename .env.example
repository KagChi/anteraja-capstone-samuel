APP_NAME="Anteraja Instant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=anteraja
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Supabase pooler: DB_SSLMODE=require and DB_SEARCH_PATH=public,extensions
DB_SSLMODE=prefer
DB_SEARCH_PATH=public
# Reuse the (remote) Postgres connection across requests to avoid TLS renegotiation.
DB_PERSISTENT=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only used when SESSION_DRIVER=redis; defaults to the "default" Redis connection.
# SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Safety-net TTL (seconds) for the presentation read caches. Writes still
# invalidate immediately; warm them on boot with `php artisan app:warm-cache`.
PERFORMANCE_CACHE_TTL=300

MEMCACHED_HOST=127.0.0.1

# Redis is optional. The app runs on the file/database drivers above by
# default; to opt in, install phpredis and switch the three drivers to redis:
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
#   SESSION_DRIVER=redis
# then `docker compose up -d redis` and `php artisan config:clear`.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
# Connections: "default" (queue/session) and "cache" (read caches) use separate DBs.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
# Namespace keys so multiple apps can share one Redis server.
# REDIS_PREFIX=
# REDIS_PERSISTENT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Proof-of-delivery photos (FRD-02). "local" keeps them under
# storage/app/private/pod; "s3" stores them in the private bucket below
# (AWS S3, Supabase Storage S3 endpoint, MinIO, ...) behind signed URLs.
POD_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Only for S3-compatible endpoints, e.g. Supabase:
# AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
